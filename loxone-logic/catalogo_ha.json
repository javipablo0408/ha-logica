    },
    {
     "abbr": "Br",
     "name": "Brillo",
     "desc": "",
     "range": "0-100"
    },
    {
     "abbr": "Ct",
     "name": "Blanco por temperatura",
     "desc": "",
     "range": "0/1"
    },
    {
     "abbr": "K",
     "name": "Temperatura",
     "desc": "",
     "range": "0-100"
    }
   ],
   "parameters": [],
   "notas": "config: {scenes:[{id,name,rgb:[0-100,0-100,0-100] | temp:0-100, br}]}"
