     "desc": "Número de escena (0 = apagar)",
     "range": "0-99"
    },
    {
     "abbr": "Br",
     "name": "Brillo",
     "desc": "0-100 %",
     "range": "0-100"
    },
    {
     "abbr": "Col",
     "name": "Color",
     "desc": "Color #rrggbb",
